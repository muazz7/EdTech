{
  "name": "edtech",
  "private": true,
  "version": "0.1.0",
  "description": "Master EdTech Platform — closed course platform for Bangladesh",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@edtech/web",
    "build": "npm run build --workspace=@edtech/web",
    "build:verify": "dotenv -v NEXT_DIST_DIR=.next-verify -- npm run build --workspace=@edtech/web",
    "start": "npm run start --workspace=@edtech/web",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "db:generate": "npm run generate --workspace=@edtech/db",
    "db:migrate": "npm run migrate --workspace=@edtech/db",
    "db:studio": "npm run studio --workspace=@edtech/db",
    "test": "tsc --build && dotenv -e .env.local -- node --test --test-concurrency=1 \"packages/core/dist/**/*.test.js\"",
    "db:check": "dotenv -e .env.local -- node scripts/db-check.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "smoke:devices": "dotenv -e .env.local -- node scripts/two-device-test.mjs",
    "smoke:builder": "dotenv -e .env.local -- node scripts/builder-smoke.mjs",
    "smoke:payments": "dotenv -e .env.local -- node scripts/payments-smoke.mjs",
    "smoke:catalog": "dotenv -e .env.local -- node scripts/catalog-smoke.mjs",
    "smoke:assessment": "dotenv -e .env.local -- node scripts/assessment-smoke.mjs",
    "smoke:commerce": "dotenv -e .env.local -- node scripts/commerce-smoke.mjs",
    "smoke:doubts": "dotenv -e .env.local -- node scripts/doubts-smoke.mjs",
    "audit:rls": "dotenv -e .env.local -- node scripts/rls-audit.mjs",
    "preflight": "dotenv -e .env.local -- node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
