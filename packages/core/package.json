{
  "name": "@edtech/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "source": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./entitlements": {
      "source": "./src/entitlements/index.ts",
      "types": "./dist/entitlements/index.d.ts",
      "default": "./dist/entitlements/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --build",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "dependencies": {
    "@edtech/db": "*",
    "@edtech/shared": "*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.38.2",
    "jose": "^5.9.6",
    "uuidv7": "^1.0.2"
  }
}
